{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auldmoney",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": true,
  "triggers": {
    "crons": [
      "0 8 * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "BOOTSTRAP_PARENT_EMAIL": "patrick@patrickauld.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auldmoney",
      "database_id": "4734fbb1-23c5-4f15-99a2-7e795fd427f1",
      "migrations_dir": "drizzle"
    }
  ]
}
